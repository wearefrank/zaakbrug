<Adapter name="GetProfileProperties" active="${GetProfileProperties.Active}">

    <Pipeline>
        <Exits>
            <Exit name="EXIT" state="SUCCESS"/>
            <Exit name="EXCEPTION" state="ERROR"/>
        </Exits>

        <Cache name="CachePerZaaktypeAndSOAPAction" eternal="true">
            <Param name="key" pattern="{zaaktype}&amp;{fromSoapAction}" />
        </Cache>

        <SenderPipe name="ResolveProfileValuesSender">
            <FrankSender
                    name="ResolveProfileValuesLocalSender"
                    target="Translate/ResolveProfileValuesSeparateFiles"
                    returnedSessionKeys="Error">
                <Param name="profilesFile" value="/opt/frank/resources/RoutingProfiles.json"/>
                <Param name="profileDefaultsFile" value="/opt/frank/resources/RoutingProfileDefaults.json"/>
            </FrankSender>
            <Forward name="success" path="SelectProfile" />
            <Forward name="exception" path="EXCEPTION" />
        </SenderPipe>

        <XsltPipe
                name="SelectProfile"
                styleSheetName="xsl/SelectProfile.xsl">
            <Param name="zaaktype" sessionKey="zaaktype" />
            <Param name="SOAPAction" sessionKey="fromSoapAction" />
        </XsltPipe>

        <PutInSessionPipe name="GetPropertiesFromProfile">
            <Param name="route" xpathExpression="//route"/>
            <Param name="stopOnError" xpathExpression="//stopOnError"/>
        </PutInSessionPipe>

        <ReplacerPipe
                name="GetAdapterName"
                getInputFromFixedValue="^{zaakbrug.frank.?{route}.endpoint}"
                find="^"
                replace="$"
                substituteVars="true"
                storeResultInSessionKey="adapterName">
            <Param name="route" sessionKey="route"/>
        </ReplacerPipe>
    </Pipeline>
</Adapter>