<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../FrankConfig.xsd">
    <Adapter name="DeleteRolFromZgw"
        active="${DeleteRolFromZgw.Active}"
        description="">

        <Pipeline>
            <Exits>
                <Exit name="EXIT" state="SUCCESS" />
                <Exit name="NOTFOUND" state="SUCCESS" code="404" />
                <Exit name="EXCEPTION" state="ERROR"/>
            </Exits>

            <SenderPipe name="GetAuthorizationHeaderForZakenApi"
                getInputFromFixedValue="&lt;dummy/&gt;"
                storeResultInSessionKey="Authorization">
                <FrankSender
                    name="GetAuthorizationHeaderForZakenApiSender"
                    target="GenerateAuthorizationHeaderForZakenApi"
                >
                </FrankSender>
                <Forward name="success" path="CheckForZgwBetrokkeneIdentificatie" />
                <Forward name="exception" path="EXCEPTION" />
            </SenderPipe>

            <!-- The input message is the ZGW role (with valueOverrides applied) that is translated from the ZDS role to delete.
                Roles are matched on the ZGW side, see the matching in CheckZgwRol. -->
            <IfPipe
                name="CheckForZgwBetrokkeneIdentificatie"
                getInputFromSessionKey="originalMessage"
                xpathExpression="string-length(/zgwRol/betrokkeneIdentificatie) > 0"
                >
                <Forward name="then" path="CallGetZgwRolesByZaakUrl"/>
                <Forward name="else" path="NOTFOUND"/>
            </IfPipe>

            <SenderPipe
                name="CallGetZgwRolesByZaakUrl"
                getInputFromFixedValue="&lt;dummy/&gt;">
                <FrankSender
                    name="GetZgwRolesByZaakUrlSender"
                    target="GetZgwRolesByZaakUrl"
                    returnedSessionKeys="Error">
                    <Param name="ZaakUrl" sessionKey="ZgwZaakUrl"/>
                </FrankSender>
                <Forward name="success" path="CallNormalizeZgwRollen"/>
                <Forward name="exception" path="EXCEPTION" />
            </SenderPipe>

            <!-- Existing roles are translated ZGW -> ZDS -> ZGW, so they are comparable with the role translated from the ZDS message. -->
            <ForEachChildElementPipe
                name="CallNormalizeZgwRollen"
                elementXPathExpression="/ZgwRollen/zgwRol">
                <FrankSender
                    name="CallNormalizeZgwRolSender"
                    target="NormalizeZgwRolViaZds"
                    returnedSessionKeys="Error">
                    <Param name="ZgwZaakType" sessionKey="ZaakType" type="DOMDOC"/>
                    <Param name="ZgwRolTypen" sessionKey="ZgwRolTypen" type="DOMDOC"/>
                    <Param name="RolMapping" sessionKey="RolMapping" type="DOMDOC"/>
                    <Param name="MatchOmschrijving" sessionKey="originalMessage" xpathExpression="/zgwRol/omschrijving"/>
                </FrankSender>
                <Forward name="success" path="UnwrapNormalizedZgwRollen"/>
                <Forward name="exception" path="EXCEPTION" />
            </ForEachChildElementPipe>

            <XsltPipe
                name="UnwrapNormalizedZgwRollen"
                styleSheetName="Common/xsl/UnwrapForEachChildPipeEnvelopeToList.xslt"
                >
                <Param name="List" value="ZgwRollen"/>
                <Forward name="success" path="SelectZgwRolesFromListWithMatchingIdentity"/>
                <Forward name="exception" path="EXCEPTION"/>
            </XsltPipe>

            <XsltPipe
                name="SelectZgwRolesFromListWithMatchingIdentity"
                styleSheetName="Common/xsl/SelectZgwRolesFromListWithMatchingIdentity.xslt"
                >
                <Param name="MatchWithZgwRol" sessionKey="originalMessage" type="DOMDOC"/>
                <Forward name="success" path="CheckForGetRolResult1"/>
                <Forward name="exception" path="EXCEPTION"/>
            </XsltPipe>

            <IfPipe 
                name="CheckForGetRolResult1"
                xpathExpression="count(/ZgwRollen/zgwRol) = 0"
                >
                <Forward name="then" path="NOTFOUND"/>
                <Forward name="else" path="CheckForGetRolResult2"/>
            </IfPipe>

            <IfPipe 
                name="CheckForGetRolResult2"
                xpathExpression="count(/ZgwRollen/zgwRol) >= 2"
                >
                <Forward name="then" path="EXCEPTION"/>
                <Forward name="else" path="DeleteRol"/>
            </IfPipe>

            <SenderPipe
                name="DeleteRol"
                >
                    <HttpSender
                        name="DeleteRolSender" 
                        methodType="DELETE"
                        headersParams="Authorization,Accept-Crs"
                        timeout="${zaakbrug.zgw.zaken-api.timeout}"
                        sharedResourceRef="zaken-api-connector"
                    >
                        <Param name="url" xpathExpression="ZgwRollen/zgwRol/url"/>
                        <Param name="Accept-Crs" value="EPSG:4326"/>
                        <Param name="Authorization"  sessionKey="Authorization" />
                    </HttpSender>
                
                <Forward name="success" path="EXIT"/>
                <Forward name="exception" path="ErrorJsonToXml" />
            </SenderPipe>

            <JsonPipe name="ErrorJsonToXml">
                <Forward name="success" path="buildErrorMsg" />
            </JsonPipe>
            <XsltPipe name="buildErrorMsg"
                styleSheetName="Common/xsl/ParseNegativeHttpResult.xsl">
                <Param name="senderPipeName" value="DeleteRol" />
                <Forward name="success" path="EXCEPTION" />
            </XsltPipe>
        </Pipeline>
    </Adapter>
</Module>