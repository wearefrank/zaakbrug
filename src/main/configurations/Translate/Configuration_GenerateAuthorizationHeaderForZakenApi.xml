<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../FrankConfig.xsd">
    <Adapter name="GenerateAuthorizationHeaderForZakenApi"
        active="${GenerateAuthorizationHeaderForZakenApi.Active}"
        description="">

        <Receiver name="GenerateAuthorizationHeaderForZakenApi">
            <JavaListener name="GenerateAuthorizationHeaderForZakenApi" />
        </Receiver>

        <Pipeline>
            <Exits>
                <Exit name="EXIT" state="SUCCESS" />
            </Exits>

            <Cache name="GenerateAuthorizationHeaderForZakenApi" keyXPath="string('GenerateAuthorizationHeaderForZakenApi')" timeToLiveSeconds="550" />

            <XmlSwitchPipe 
                name="CheckForAuthType"
                xpathExpression="$valueAuthType"
                >
                <Param name="valueAuthType" value="${zaakbrug.zgw.zaken-api.auth-type}"/>
                <Forward name="jwt" path="createJwt"/>
                <Forward name="basic" path="GetUserCredentialForBasicAuth"/>
                <Forward name="value" path="CreateValueAuthorizationHeader"/>
            </XmlSwitchPipe>

            <!-- jwtTokenGeneratorPipe -->
            <JwtPipe name="createJwt"
                expirationTime="600"
                storeResultInSessionKey="myToken"
                authAlias="${zaakbrug.zgw.zaken-api.auth-alias}">
                <Param name="client_id" pattern="{username}" authAlias="${zaakbrug.zgw.zaken-api.auth-alias}" hidden="true"/>
                <Param name="user_id" pattern="{username}" authAlias="${zaakbrug.zgw.zaken-api.auth-alias}" hidden="true"/>
                <Param name="user_representation" pattern="{username}" authAlias="${zaakbrug.zgw.zaken-api.auth-alias}" hidden="true"/>
                <Forward name="success" path="CreateJwtAuthorizationHeader" />
                <Forward name="exception" path="EXCEPTION" />
            </JwtPipe>

            <ReplacerPipe name="CreateJwtAuthorizationHeader" getInputFromFixedValue="Bearer ?{myToken}">
                <Param name="myToken" sessionKey="myToken"/>
                <Forward name="success" path="EXIT" />
                <Forward name="exception" path="EXCEPTION" />
            </ReplacerPipe>

            <PutInSessionPipe name="GetUserCredentialForBasicAuth">
                <Param name="user_credential" xpathExpression="concat($username,':',$password)" hidden="true">
                    <Param name="username" pattern="{username}" authAlias="${zaakbrug.zgw.zaken-api.auth-alias}" hidden="true"/>
                    <Param name="password" pattern="{password}" authAlias="${zaakbrug.zgw.zaken-api.auth-alias}" hidden="true"/>
                </Param>
                <Forward name="success" path="CreateBasicAuthToken" />
            </PutInSessionPipe>

            <!-- basicTokenGeneratorPipe -->
            <Base64Pipe name="CreateBasicAuthToken" getInputFromSessionKey="user_credential">
                <Forward name="success" path="CreateBasicAuthorizationHeader" />
                <Forward name="exception" path="EXCEPTION" />
            </Base64Pipe>

            <ReplacerPipe name="CreateBasicAuthorizationHeader" getInputFromFixedValue="Basic ?{myToken}">
                <Param name="myToken" sessionKey="myToken"/>
                <Forward name="success" path="EXIT" />
                <Forward name="exception" path="EXCEPTION" />
            </ReplacerPipe>

            <!-- valueTokenGeneratorPipe -->
            <ReplacerPipe name="CreateValueAuthorizationHeader" getInputFromFixedValue="?{Authorization}">
                <Param name="Authorization" pattern="{password}" authAlias="${zaakbrug.zgw.zaken-api.auth-alias}" hidden="true"/>
                <Forward name="success" path="EXIT" />
            </ReplacerPipe>

            <ExceptionPipe name="EXCEPTION">
                <NumberParam name="exitCode" value="42"/>
                <NumberParam name="errorCode" value="-1"/>
                <Param name="Error" value="No clue, but there is supposed to be a sessionKey"/>
            </ExceptionPipe>
        </Pipeline>
    </Adapter>
</Module>